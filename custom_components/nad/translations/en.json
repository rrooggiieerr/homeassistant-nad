    "issues": {
        "binary_protocol_not_supported": {
            "description": "The NAD device {title} was configured with an earlier version of this custom integration using the binary TCP protocol (e.g. the D 7050). This protocol is not supported by this custom integration, so the device is not available.\n\nRemove this device from the NAD integration. To use the device with the built-in NAD integration instead, uninstall this custom integration and configure the device in YAML.",
            "title": "{title} uses an unsupported protocol"
        },
        "deprecated_yaml": {
            "description": "Configuring NAD using YAML is not supported by this custom integration.\n\nYour existing YAML configuration has been imported into the UI automatically.\n\nRemove the `nad` configuration from your configuration.yaml file and restart Home Assistant to fix this issue.",
            "title": "The NAD YAML configuration is not supported"
        },
        "deprecated_yaml_import_issue_cannot_connect": {
            "description": "Configuring NAD using YAML is not supported by this custom integration. While importing your YAML configuration, the device on {url} could not be reached.\n\nPlease ensure the device is accessible and restart Home Assistant to retry, or remove the `nad` configuration from your configuration.yaml and set up the integration via the UI.",
            "title": "The NAD YAML configuration is not supported"
        },
        "yaml_tcp_not_supported": {
            "description": "Your NAD YAML configuration uses `type: TCP`, which is not supported by this custom integration. This custom integration replaces the built-in NAD integration, so this device is no longer available.\n\nUninstall the NAD custom integration and restart Home Assistant to use the built-in integration again.",
            "title": "The NAD TCP protocol is not supported"
        }
    },
